DirectoryIndex index.php index.html
RewriteEngine on
RewriteBase /

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

#пренасочване на страниците от стария сайт
RewriteRule ^$ index.php [L]
RewriteRule ^service\.php$ za-nas [R=301]
RewriteRule ^announce\.php$ finansovi-programi [R=301]
RewriteRule ^club_nbn\.php$ ikonomicheski-paket [R=301]
RewriteRule ^product-cause\.php$ nashata-socialna-kauza [R=301]
RewriteRule ^enquiry\.php$ chlenstvo [R=301]
RewriteRule ^ppbg\.php$ politika-za-zashtita-na-lichnite-danni [R=301]
RewriteRule ^cpbg\.php$ politika-otnosno-izpolzvaneto-na-biskvitki [R=301]

#пренасочване - сео 
RewriteRule ^test$ test.php [L]
RewriteRule ^za-nas$ about-us.php [L]
RewriteRule ^struktura$ structure.php [L]
RewriteRule ^novini$ allnews.php [L]
RewriteRule ^finansovi-programi$ financing.php [L]
RewriteRule ^za-kontakt-s-nas$ contacts.php [L]
RewriteRule ^chlenstvo$ statute-membership.php [L]
RewriteRule ^ikonomicheski-paket$ business-package.php [L]
RewriteRule ^sabitia$ allhappenings.php [L]
RewriteRule ^nashata-socialna-kauza$ friend.php [L]
RewriteRule ^firmi-chlenove$ firms.php [L]
RewriteRule ^biznes-oferti$ all-business-offers.php [L]
RewriteRule ^politika-za-zashtita-na-lichnite-danni$ privacy-policy.php [L]
RewriteRule ^politika-otnosno-izpolzvaneto-na-biskvitki$ cookie-policy.php [L]

#референции

RewriteRule ^references$ refs.php [L]
RewriteRule ^reference-raina-kniaginia$ ref1.php [L]
RewriteRule ^reference-artcommerce$ ref2.php [L]
RewriteRule ^reference-vassilev-partners$ ref3.php [L]
RewriteRule ^reference-stiv$ ref4.php [L]
RewriteRule ^reference-iupp$ ref5.php [L]
RewriteRule ^reference-btpp$ ref6.php [L]
RewriteRule ^reference-ianmsp$ ref7.php [L]
RewriteRule ^reference-mis-associates$ ref8.php [L]
RewriteRule ^reference-eurobank$ ref9.php [L]
RewriteRule ^reference-thankyou$ ref10.php [L]
RewriteRule ^reference-eurobank2$ ref11.php [L]

ErrorDocument 404 https://nbn-bg.com/404.php

# ---------------------------------------------------------------------------
# Short addresses of news / events / offers (replaces the old per-article rules)
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)$ router.php?slug=$1 [L,QSA,B]

# ---------------------------------------------------------------------------
# Never serve these to visitors
# ---------------------------------------------------------------------------
# (admin-edited content blocks are locked by the .htaccess in their own folders)
<Files "_init.php">
    Require all denied
</Files>
<FilesMatch "\.(inc|log|sql|sqlite|ini|bak|zip|rar|php\d|zzz|md|dist|lock)$|^(error_log|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
Options -Indexes

# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit
